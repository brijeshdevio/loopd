@base_url = http://localhost:3000/api/v1


### Root route
GET  {{base_url}}/


### Health route
GET {{base_url}}/health


### Register user
POST {{base_url}}/auth/register
Content-Type: application/json

{
  "name": "Raj Kumar",
  "email": "raj@rajelectronics.com",
  "password": "Raj@12345",
  "phone": "9876543210",
  "shopName": "Raj Electronics",
  "shopCategory": "ELECTRONICS"
}


### Login user
POST {{base_url}}/auth/login
Content-Type: application/json

{
  "email": "raj@rajelectronics.com",
  "password": "Raj@12345"
}


### Logout user
POST {{base_url}}/auth/logout


### Get Logged-in user
GET {{base_url}}/auth/me


### Update user profile
PATCH {{base_url}}/auth/me
Content-Type: application/json

{
  "shopName": "Raj Electronics & Co."
}


### Change password
PATCH {{base_url}}/auth/change-password
Content-Type: application/json

{
  "currentPassword": "Raj@12345",
  "newPassword": "NewRaj@99"
}


### Find customers
GET {{base_url}}/customers


### Add customer
POST {{base_url}}/customers
Content-Type: application/json

{
  "name": "Arjun Mehta",
  "phone": "9812345678",
  "email": "arjun@gmail.com",
  "lastVisitDate": "2025-04-17",
  "notes": "Interested in water purifier",
  "followUp": {
    "type": "CALL",
    "scheduledAt": "2025-05-17T09:00:00.000Z",
    "priority": "HIGH",
    "notes": "Ask about purifier interest"
  }
}

### Update customer
PATCH {{base_url}}/customers/cmp2bokne0000mscpbm7vwwfy
Content-Type: application/json

{
  "name": "Arjun",
  "phone": "9812345678",
  "email": "arjun@ex.com",
  "lastVisitDate": "2025-05-17",
  "notes": "Bought water purifier. May need filter replacement."
}


### Get customer
GET {{base_url}}/customers/cmp2bokne0000mscpbm7vwwfy


### Delete customer
DELETE {{base_url}}/customers/cmp2bokne0000mscpbm7vwwfy


### Restore deleted customer
PATCH {{base_url}}/customers/cmp2bokne0000mscpbm7vwwfy/restore


### Find follow-ups
GET {{base_url}}/follow-ups


### Find follow-up
GET {{base_url}}/follow-ups/cmp2bole70001mscpnwfy2lux


### Create follow-up
POST {{base_url}}/follow-ups
Content-Type: application/json

{
  "customerId": "cmp2bokne0000mscpbm7vwwfy",
  "type": "CALL",
  "scheduledAt": "2025-05-20T10:00:00.000Z",
  "priority": "MEDIUM",
  "notes": "Check if filter replacement is needed"
}


### Update follow-up
PATCH {{base_url}}/follow-ups/cmp74ekdz0001ytcpuhn8v612
Content-Type: application/json

{
  "type": "VISIT",
  "priority": "HIGH"
}


### Done follow-up
PATCH {{base_url}}/follow-ups/cmp74ekdz0001ytcpuhn8v612/done
Content-Type: application/json

{
  "outcomeNotes": "Arjun confirmed, will come Saturday to buy purifier",
  "nextFollowUp": {
    "type": "VISIT",
    "scheduledAt": "2025-05-20T11:00:00.000Z",
    "priority": "HIGH",
    "notes": "Confirm purifier purchase"
  }
}


### reschedule follow-up
PATCH {{base_url}}/follow-ups/cmp2bole70001mscpnwfy2lux/reschedule
Content-Type: application/json

{
  "scheduledAt": "2025-05-20T11:00:00.000Z",
  "notes": "Confirm purifier purchase"
}


### no-response follow-up
PATCH {{base_url}}/follow-ups/cmp2bole70001mscpnwfy2lux/no-response
Content-Type: application/json

{
  "outcomeNotes": "Called twice, no answer"
}


### Delete follow-up
DELETE {{base_url}}/follow-ups/cmp7x629d0000ntcp89tc263f


### dashboard stats
GET {{base_url}}/dashboard/stats