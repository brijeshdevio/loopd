@base_url = http://localhost:3000/api/v1


### Root route
GET  {{base_url}}/


### Health route
GET {{base_url}}/health


### Register user
POST {{base_url}}/auth/register
Content-Type: application/json

{
  "name": "Raj Kumar",
  "email": "raj@rajelectronics.com",
  "password": "Raj@12345",
  "phone": "9876543210",
  "shopName": "Raj Electronics",
  "shopCategory": "ELECTRONICS"
}


### Login user
POST {{base_url}}/auth/login
Content-Type: application/json

{
  "email": "raj@rajelectronics.com",
  "password": "Raj@12345"
}


### Logout user
POST {{base_url}}/auth/logout


### Get Logged-in user
GET {{base_url}}/auth/me


### Update user profile
PATCH {{base_url}}/auth/me
Content-Type: application/json

{
  "shopName": "Raj Electronics & Co."
}


### Change password
PATCH {{base_url}}/auth/change-password
Content-Type: application/json

{
  "currentPassword": "Raj@12345",
  "newPassword": "NewRaj@99"
}


### Find customers
GET {{base_url}}/customers


### Add customer
POST {{base_url}}/customers
Content-Type: application/json

{
  "name": "Arjun Mehta",
  "phone": "9812345678",
  "email": "arjun@gmail.com",
  "lastVisitDate": "2025-04-17",
  "notes": "Interested in water purifier",
  "followUp": {
    "type": "CALL",
    "scheduledAt": "2025-05-17T09:00:00.000Z",
    "priority": "HIGH",
    "notes": "Ask about purifier interest"
  }
}

### Update customer
PATCH {{base_url}}/customers/cmp2bokne0000mscpbm7vwwfy
Content-Type: application/json

{
  "name": "Arjun",
  "phone": "9812345678",
  "email": "arjun@ex.com",
  "lastVisitDate": "2025-05-17",
  "notes": "Bought water purifier. May need filter replacement."
}


### Get customer
GET {{base_url}}/customers/cmp2bokne0000mscpbm7vwwfy